### Step 1 — Skeleton Extraction (Landmark Printing)
**Goal**: Load a video, run MediaPipe Pose frame-by-frame, print raw 3D coordinates of Shoulder/Elbow/Wrist.

#### [NEW] `prototype.py`
Minimal script (~50 lines):

```python
"""
Cricket Chucking Detector — Step 1: Skeleton Extraction
Loads a video, runs MediaPipe Pose Landmarker, prints 3D bowling-arm
coordinates (Shoulder, Elbow, Wrist) for every frame.
"""
import cv2
import mediapipe as mp
from mediapipe.tasks import python
from mediapipe.tasks.python import vision

# --- Configuration ---
VIDEO_PATH = "bowling_clip.mp4"          # ← Replace with your video filename
MODEL_PATH = "pose_landmarker_full.task"  # Downloaded model file
ARM_SIDE = "right"                        # "right" or "left"

# Landmark indices
if ARM_SIDE == "right":
    SHOULDER_IDX, ELBOW_IDX, WRIST_IDX = 12, 14, 16
else:
    SHOULDER_IDX, ELBOW_IDX, WRIST_IDX = 11, 13, 15

# --- Set up PoseLandmarker ---
base_options = python.BaseOptions(model_asset_path=MODEL_PATH)
options = vision.PoseLandmarkerOptions(
    base_options=base_options,
    running_mode=vision.RunningMode.VIDEO,
)

cap = cv2.VideoCapture(VIDEO_PATH)
fps = cap.get(cv2.CAP_PROP_FPS)
print(f"Video: {VIDEO_PATH} | FPS: {fps:.1f}")

with vision.PoseLandmarker.create_from_options(options) as landmarker:
    frame_idx = 0
    while cap.isOpened():
        ret, frame = cap.read()
        if not ret:
            break

        # Convert BGR → RGB and wrap for MediaPipe
        rgb = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)
        timestamp_ms = int(frame_idx * 1000 / fps)

        result = landmarker.detect_for_video(mp_image, timestamp_ms)

        if result.pose_world_landmarks:
            wl = result.pose_world_landmarks[0]  # First detected person
            s = wl[SHOULDER_IDX]
            e = wl[ELBOW_IDX]
            w = wl[WRIST_IDX]
            print(
                f"Frame {frame_idx:4d} | "
                f"Shoulder({s.x:+.4f}, {s.y:+.4f}, {s.z:+.4f}) | "
                f"Elbow({e.x:+.4f}, {e.y:+.4f}, {e.z:+.4f}) | "
                f"Wrist({w.x:+.4f}, {w.y:+.4f}, {w.z:+.4f})"
            )
        else:
            print(f"Frame {frame_idx:4d} | No pose detected")

        frame_idx += 1

cap.release()
print(f"\nDone. Processed {frame_idx} frames.")
```

**What you'll learn**: How MediaPipe's world landmarks give you real metric 3D coordinates anchored at the hip. These are the raw inputs for all angle calculations.

**Setup required before running**:
```bash
pip install mediapipe opencv-python
```
```bash
